          ],
          "children": [
            {
              "type": "text",
              "id": "LB6Af",
              "name": "Research Themes",
              "context": "h2",
              "fill": "#000000",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Research Themes",
              "lineHeight": 1.38,
              "textAlign": "center",
              "fontFamily": "Source Sans Pro",
              "fontSize": 36,
              "fontWeight": "300",
              "letterSpacing": -1.8
            },
            {
              "type": "frame",
              "id": "t4qdzz",
              "name": "spacer",
              "width": "fill_container",
              "height": 16,
              "layout": "none"
            },
            {
              "type": "text",
              "id": "WNlYm",
              "name": "연구 주제 키워드: 딥페이크 정보처리, AI 시대 진정성과 사회적 신뢰,",
              "context": "p",
              "fill": "#000000",
              "textGrowth": "fixed-width-height",
              "width": "fill_container",
              "height": 52.78,
              "content": "연구 주제 키워드: 딥페이크 정보처리, AI 시대 진정성과 사회적 신뢰, AI 활용 격차 및 리터러시, AI와 양극화, 소셜미디어/온라인 게임 이용과 효과",
              "lineHeight": 1.65,
              "textAlign": "center",
              "fontFamily": "Source Sans Pro",
              "fontSize": 16,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "D8yYx",
              "name": "spacer",
              "width": "fill_container",
              "height": 32,
              "layout": "none"
            },
            {
              "type": "text",
              "id": "G9SGY",
              "name": "I study the psychological and interperso",
              "context": "p",
              "fill": "#000000",
              "textGrowth": "fixed-width-height",
              "width": "fill_container",
              "height": 158.34,
              "content": "I study the psychological and interpersonal processes within social media and online games, with a particular focus on how advances in AI reshape mediated interaction. My research also explores how the public makes sense of emerging technologies and their broader societal and political implications. Currently, my AI-related projects investigate AI-Mediated communication (AI-MC) and authenticity, AI and polarization, AI and public opinion formation, and AI divide and literacy. I serve as a Co-I at the AI.POLICI Lab, where I collaborate on research regarding AI and polarization. Additionally, I have a long-standing involvement with the Annenberg Game Lab, where I continue to collaborate on game-based research.",
              "lineHeight": 1.65,
              "textAlign": "center",
              "fontFamily": "Source Sans Pro",
              "fontSize": 16,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "HHQvO",
              "name": "spacer",
              "width": "fill_container",
              "height": 32.01,
              "layout": "none"
            },
            {
              "type": "text",
              "id": "lvFCS",
              "name": "My work has been published in leading pe",
              "context": "p",
              "fill": "#000000",
              "textGrowth": "fixed-width-height",
              "width": "fill_container",
              "height": 79.17,
              "content": "My work has been published in leading peer-reviewed journals, such as Communication Research, Computers in Human Behavior, Journalism & Mass Communication Quarterly, Mass Communication & Society, Media Psychology, New Media & Society and Science Communication. A list of my publications is available at Google Scholar and ResearchGate.",
              "lineHeight": 1.65,
              "textAlign": "center",
              "fontFamily": "Source Sans Pro",
              "fontSize": 16,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "X90Prm",
              "name": "spacer",
              "width": "fill_container",
              "height": 32,
              "layout": "none"
            },
            {
              "type": "text",
              "id": "U5BdUy",
              "name": "You can explore a selection of my repres",
              "context": "p",
              "fill": "#000000",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "You can explore a selection of my representative works by clicking the images below.",
              "lineHeight": 1.65,
              "textAlign": "center",
              "fontFamily": "Source Sans Pro",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
