              "layout": "none"
            },
            {
              "type": "frame",
              "id": "hnqF3",
              "name": "p",
              "context": "p",
              "width": "fill_container",
              "layout": "vertical",
              "padding": [
                3,
                0,
                4.34,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "iLxBh",
                  "name": "Hello! My name is Sukyoung Choi. I am an",
                  "context": "b",
                  "fill": "#ffffff",
                  "textGrowth": "fixed-width",
                  "width": 542.42,
                  "content": "Hello! My name is Sukyoung Choi. I am an Assistant Professor in the Department of Communication at Yonsei University. My research investigates the intersection of emerging communication technologies (such as AI and online games) and their psychological and societal impacts, with an emphasis on quantitative methods.\n\nI received my Ph.D. from the Annenberg School for Communication and Journalism at the University of Southern California, and my M.A. and B.A. in Communication from Seoul National University. My dissertation, which examined how individuals process deepfake information in AI-mediated communication, was honored with the Herbert S. Dordick Dissertation Award from the International Communication Association (ICA). Building on this line of inquiry, my subsequent research was further recognized with the 1st Korea Foundation for Advanced Studies (KFAS) Award for Social Innovation Research.",
                  "lineHeight": 1.65,
                  "textAlign": "center",
                  "fontFamily": "Source Sans Pro",
                  "fontSize": 19,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "op9CI",
              "name": "spacer",
              "width": "fill_container",
