                {
                  "type": "text",
                  "id": "SJEtt",
                  "name": "Education",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": 688,
                  "content": "I received my Ph.D. from the Annenberg School for Communication and Journalism at the University of Southern California, and my M.A. and B.A. in Communication from Seoul National University.",
                  "lineHeight": 1.52,
                  "fontFamily": "$font-body",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "DjVfy",
                  "name": "Dissertation and recognition",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": 688,
                  "content": "My dissertation, which examined how individuals process deepfake information in AI-mediated communication, was honored with the Herbert S. Dordick Dissertation Award from the International Communication Association (ICA). Building on this line of inquiry, my subsequent research was further recognized with the 1st Korea Foundation for Advanced Studies (KFAS) Award for Social Innovation Research.",
                  "lineHeight": 1.52,
                  "fontFamily": "$font-body",
                  "fontSize": 18,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
