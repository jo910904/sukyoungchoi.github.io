                              "width": 360,
                              "content": "Deepfake News Exposure",
                              "lineHeight": 1.2,
                              "fontFamily": "$font-display",
                              "fontSize": 23,
                              "fontWeight": "bold"
                            },
                            {
                              "type": "text",
