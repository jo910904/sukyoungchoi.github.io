            {
              "type": "text",
              "id": "dhnMv",
              "name": "최석영 | 연세대학교 언론홍보영상학부 조교수",
              "context": "p",
              "fill": "#ffffff",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "최석영 | 연세대학교 언론홍보영상학부 조교수",
              "lineHeight": 1.65,
              "textAlign": "center",
              "fontFamily": "Source Sans Pro",
              "fontSize": 19,
              "fontWeight": "300"
            },
            {
              "type": "frame",
              "id": "n9Tgtu",
              "name": "spacer",
