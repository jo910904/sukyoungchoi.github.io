              "padding": [
                88,
                40,
                48,
                40
              ],
              "children": [
                {
                  "type": "frame",
                  "id": "Umast",
                  "name": "Research heading and keywords",
                  "width": 688,
                  "layout": "vertical",
                  "gap": 24,
                  "children": [
                    {
                      "type": "text",
                      "id": "xrlVv",
                      "name": "Research heading",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
