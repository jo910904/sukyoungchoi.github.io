          "children": [
            {
              "type": "frame",
              "id": "WwzhY",
              "name": "Research introduction",
              "width": 390,
              "layout": "vertical",
              "gap": 24,
              "padding": [
                88,
                24,
                48,
                24
              ],
              "children": [
                {
                  "type": "frame",
                  "id": "polgf",
                  "name": "Research heading and keywords",
                  "width": 342,
                  "layout": "vertical",
                  "gap": 24,
                  "children": [
                    {
                      "type": "text",
                      "id": "Q3p2t",
                      "name": "Research heading",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": 342,
